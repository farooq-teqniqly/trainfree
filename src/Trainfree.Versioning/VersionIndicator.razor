@namespace Trainfree.Versioning
@implements IDisposable
@inject IVersionCheck VersionCheck
@inject VersionStamp Running
@inject NavigationManager Navigation
@inject ILogger<VersionIndicator> Logger

@if (_stale is not null)
{
    <div class="version-update" role="alert">
        <span>Version @_stale.Deployed.Version is deployed; this tab is running @Running.Version.</span>
        <button type="button" class="btn btn-sm btn-primary" @onclick="Reload">Reload</button>
    </div>
}

<span class="version-stamp">@Running.Display</span>

@code {
    private readonly CancellationTokenSource _cts = new();
    private RunningStaleVersion? _stale;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // VersionUnknown is deliberately indistinguishable from up-to-date in the UI:
            // being offline or having an expired Access session is not a staleness signal.
            if (await VersionCheck.CheckAsync(_cts.Token) is RunningStaleVersion stale)
            {
                _stale = stale;
            }
        }
        // Disposal cancels _cts while the check is in flight, so CheckAsync's own
        // filter lets this propagate instead of degrading to VersionUnknown. Swallow it
        // here rather than letting the component's lifecycle task end Faulted for a
        // teardown that already happened.
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            LogDisposedWhileCheckInFlight(Logger);
        }
    }

    private void Reload() => Navigation.Refresh(forceReload: true);

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
    }
}
