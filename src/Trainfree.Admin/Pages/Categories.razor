@page "/categories"
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Trainfree.Admin.Admin
@using Trainfree.Domain.Ids
@inject ICategoriesApiClient Api
@inject ILogger<Categories> Logger

<PageTitle>Categories - Trainfree Admin</PageTitle>

<div class="page-header d-flex align-items-end justify-content-between flex-wrap gap-3">
    <div>
        <h1>Categories</h1>
        <p class="page-sub mb-0">
            The canonical category library -- names like "Warm Up" or "A" live here once,
            and program sessions pick from this list instead of typing free text.
        </p>
    </div>
    @if (_rows.Count > 0)
    {
        <button
            class="btn btn-dark"
            data-testid="add-category"
            @onclick="AddCategoryAsync"
        >
            <i class="bi bi-plus-circle" aria-hidden="true"></i>
            Add Category
        </button>
    }
</div>

@if (_addCategoryError is not null)
{
    <div class="text-danger small mb-2" data-testid="add-category-error">@_addCategoryError</div>
}

@if (_deleteError is not null)
{
    <div class="text-danger small mb-2" data-testid="delete-category-error">@_deleteError</div>
}

@if (_loadError is not null)
{
    <div class="text-danger small mb-2" data-testid="load-categories-error">@_loadError</div>
}

@if (_rows.Count == 0)
{
    <div class="text-center py-5" data-testid="categories-empty">
        <div class="tile-icon mx-auto mb-3" aria-hidden="true">
            <i class="bi bi-tags-fill"></i>
        </div>
        <h2 class="h5">No categories yet</h2>
        <p class="page-sub mx-auto">
            Your category library holds the canonical names sessions group exercises
            under -- things like "Warm Up" or "A". Add your first one, then pick it from
            any session instead of typing it out.
        </p>
        <button class="btn btn-dark" data-testid="add-category-empty" @onclick="AddCategoryAsync">
            <i class="bi bi-plus-circle" aria-hidden="true"></i>
            Add Category
        </button>
    </div>
}
else
{
    <div class="sheet-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr class="row-depth-0">
                        <td>
                            <div class="name-cell">
                                <input
                                    class="cell-input"
                                    data-testid="name-input-@row.Id"
                                    value="@row.Name"
                                    autofocus="@(row.Id == _editingId)"
                                    @oninput="e => row.Name = (string)e.Value!" />
                                <div class="name-actions">
                                    @if (row.IsDirty)
                                    {
                                        <button
                                            class="btn btn-sm btn-icon btn-outline-dark"
                                            data-testid="save-@row.Id"
                                            title="Save"
                                            @onclick="() => RenameAsync(row)"
                                        >
                                            <i class="bi bi-floppy" aria-hidden="true"></i>
                                            <span class="visually-hidden">Save</span>
                                        </button>
                                        <button
                                            class="btn btn-sm btn-icon btn-outline-secondary"
                                            data-testid="revert-@row.Id"
                                            title="Revert"
                                            @onclick="() => Revert(row)"
                                        >
                                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                            <span class="visually-hidden">Revert</span>
                                        </button>
                                    }
                                    <button
                                        class="btn btn-sm btn-icon btn-outline-danger"
                                        data-testid="delete-@row.Id"
                                        title="Delete"
                                        @onclick="() => DeleteAsync(row)"
                                    >
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                        <span class="visually-hidden">Delete</span>
                                    </button>
                                </div>
                            </div>
                            @if (row.Error is not null)
                            {
                                <div class="text-danger small" data-testid="name-error-@row.Id">
                                    @row.Error
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly List<CategoryRow> _rows = [];
    private CategoryId? _editingId;
    private string? _addCategoryError;
    private string? _deleteError;
    private string? _loadError;

    private const int MinNameLength = 4;
    private const int MaxNameLength = 100;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var categories = await Api.GetCategoriesAsync();
            _rows.AddRange(categories.Select(c => new CategoryRow(c.Id, c.Name)));
        }
        // HttpRequestException alone was not enough: Cloudflare Access answers a request made
        // before the session is established with its own HTML login page, which arrives as a
        // JsonException and escaped, blanking the page instead of showing the load error.
        // The charset and content-type cases come with it; a timeout arrives as a cancellation.
        catch (Exception ex)
            when (ex
                    is HttpRequestException
                        or JsonException
                        or InvalidOperationException
                        or NotSupportedException
                        or OperationCanceledException
            )
        {
            _loadError = "Could not load categories. Try refreshing the page.";
            LogLoadCategoriesFailed(Logger, ex);
        }
    }

    private async Task AddCategoryAsync()
    {
        var outcome = await Api.CreateCategoryAsync("New Category");
        switch (outcome)
        {
            case CreateCategorySucceeded succeeded:
                _rows.Add(new CategoryRow(succeeded.Category.Id, succeeded.Category.Name));
                _editingId = succeeded.Category.Id;
                _addCategoryError = null;
                break;
            case CreateCategoryFailed failed:
                _addCategoryError = failed.Error;
                break;
        }
    }

    private async Task RenameAsync(CategoryRow row)
    {
        var trimmedLength = row.Name.Trim().Length;
        if (trimmedLength is < MinNameLength or > MaxNameLength)
        {
            row.Error = $"Name must be between {MinNameLength} and {MaxNameLength} characters.";
            return;
        }

        var outcome = await Api.RenameCategoryAsync(row.Id, row.Name);
        switch (outcome)
        {
            case RenameCategorySucceeded succeeded:
                row.Name = succeeded.Category.Name;
                row.SavedName = succeeded.Category.Name;
                row.Error = null;
                break;
            case RenameCategoryFailed failed:
                row.Error = failed.Error;
                break;
        }
    }

    private static void Revert(CategoryRow row)
    {
        row.Name = row.SavedName;
        row.Error = null;
    }

    private async Task DeleteAsync(CategoryRow row)
    {
        var outcome = await Api.DeleteCategoryAsync(row.Id);
        switch (outcome)
        {
            case DeleteCategorySucceeded:
                _rows.Remove(row);
                _deleteError = null;
                break;
            case DeleteCategoryFailed failed:
                _deleteError = failed.Error;
                break;
        }
    }

    private sealed class CategoryRow
    {
        public CategoryRow(CategoryId id, string name)
        {
            Id = id;
            Name = name;
            SavedName = name;
        }

        public CategoryId Id { get; }
        public string Name { get; set; }
        public string SavedName { get; set; }
        public bool IsDirty => !string.Equals(Name, SavedName, StringComparison.Ordinal);
        public string? Error { get; set; }
    }
}
