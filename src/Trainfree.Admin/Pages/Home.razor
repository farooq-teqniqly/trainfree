@page "/"

<PageTitle>Home - Trainfree Admin</PageTitle>

<div class="page-header">
    <h1>Welcome back</h1>
    <p class="page-sub">
        This is where you manage everything the workout app runs off of -- the programs
        your workouts follow, and the phase and exercise libraries they pull from.
    </p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3 card-grid">
    <div class="col">
        <NavLink class="card h-100 text-decoration-none text-body tile" href="programs" data-testid="home-tile-programs">
            <div class="card-body">
                <div class="tile-icon" aria-hidden="true">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </div>
                <h2 class="h5 card-title">Programs</h2>
                <p class="card-text">
                    Build out programs, sessions and phases, then pick exercises for
                    each one from your library.
                </p>
                <span class="tile-link">
                    Manage Programs
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </span>
            </div>
        </NavLink>
    </div>

    <div class="col">
        <NavLink class="card h-100 text-decoration-none text-body tile" href="phases" data-testid="home-tile-phases">
            <div class="card-body">
                <div class="tile-icon" aria-hidden="true">
                    <i class="bi bi-tags-fill"></i>
                </div>
                <h2 class="h5 card-title">Phases</h2>
                <p class="card-text">
                    The canonical phase library -- names like "Warm Up" or "Legs", managed
                    once and reused across every session.
                </p>
                <span class="tile-link">
                    Manage Phases
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </span>
            </div>
        </NavLink>
    </div>

    <div class="col">
        <NavLink class="card h-100 text-decoration-none text-body tile" href="exercises" data-testid="home-tile-exercises">
            <div class="card-body">
                <div class="tile-icon" aria-hidden="true">
                    <i class="bi bi-lightning-fill"></i>
                </div>
                <h2 class="h5 card-title">Exercises</h2>
                <p class="card-text">
                    The canonical exercise library -- name and image, managed once and
                    reused across every program.
                </p>
                <span class="tile-link">
                    Manage Exercises
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </span>
            </div>
        </NavLink>
    </div>
</div>
