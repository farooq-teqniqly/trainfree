@page "/"

<PageTitle>Home - Trainfree Admin</PageTitle>

<div class="page-header">
    <h1>Welcome back</h1>
    <p class="page-sub">
        This is where you manage everything the workout app runs off of -- the programs
        your workouts follow, and the phase and exercise libraries they pull from.
    </p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-3 card-grid">
    <div class="col">
        <NavCard
            Href="programs"
            TestId="home-tile-programs"
            IconClass="bi-grid-3x3-gap-fill"
            Title="Programs"
            Description="Build out programs, sessions and phases, then pick exercises for each one from your library."
            LinkLabel="Manage Programs"
        />
    </div>

    <div class="col">
        <NavCard
            Href="phases"
            TestId="home-tile-phases"
            IconClass="bi-tags-fill"
            Title="Phases"
            Description='The canonical phase library -- names like "Warm Up" or "Legs", managed once and reused across every session.'
            LinkLabel="Manage Phases"
        />
    </div>

    <div class="col">
        <NavCard
            Href="exercises"
            TestId="home-tile-exercises"
            IconClass="bi-lightning-fill"
            Title="Exercises"
            Description="The canonical exercise library -- name, managed once and reused across every program."
            LinkLabel="Manage Exercises"
        />
    </div>
</div>
