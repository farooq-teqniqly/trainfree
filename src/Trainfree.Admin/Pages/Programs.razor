    private const int MinNameLength = 4;
    private const int MaxNameLength = 100;

    private async Task RenameAsync(ProgramRow row)
    {
        if (row.IsSaving)
        {
            return;
        }

        var trimmedLength = row.Name.Trim().Length;
        if (trimmedLength is < MinNameLength or > MaxNameLength)
        {
            row.Error = $"Name must be between {MinNameLength} and {MaxNameLength} characters.";
            return;
        }

        row.IsSaving = true;
        try
        {
            var outcome = await Api.RenameProgramAsync(row.Id, row.Name);
            switch (outcome)
            {
                case RenameProgramSucceeded succeeded:
                    row.Name = succeeded.Program.Name;
                    row.SavedName = succeeded.Program.Name;
                    row.Error = null;
                    break;
                case RenameProgramFailed failed:
                    row.Error = failed.Error;
                    break;
            }
        }
        finally
        {
            row.IsSaving = false;
        }
    }

