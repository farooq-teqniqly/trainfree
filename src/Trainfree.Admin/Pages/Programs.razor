@page "/programs"
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Trainfree.Admin.Admin
@using Trainfree.Domain.Ids
@using Trainfree.Domain.ProgramExercises
@inject IProgramsApiClient Api
@inject ISessionsApiClient SessionsApi
@inject IPhasesApiClient PhasesApi
@inject ISessionPhasesApiClient SessionPhasesApi
@inject IExercisesApiClient ExercisesApi
@inject IProgramExercisesApiClient ProgramExercisesApi
@inject ILogger<Programs> Logger

<PageTitle>Programs - Trainfree Admin</PageTitle>

<div class="page-header d-flex align-items-end justify-content-between flex-wrap gap-3">
    <div>
        <h1>Programs</h1>
        <p class="page-sub mb-0">
            Build out programs and sessions for your workouts.
        </p>
    </div>
    <button
        class="btn btn-dark"
        data-testid="add-program"
        @onclick="AddProgramAsync"
    >
        <i class="bi bi-plus-circle" aria-hidden="true"></i>
        Add Program
    </button>
</div>

@if (_addProgramError is not null)
{
    <div class="text-danger small mb-2" data-testid="add-program-error">@_addProgramError</div>
}

@if (_addSessionError is not null)
{
    <div class="text-danger small mb-2" data-testid="add-session-error">@_addSessionError</div>
}

@if (_deleteError is not null)
{
    <div class="text-danger small mb-2" data-testid="delete-program-error">@_deleteError</div>
}

@if (_deleteSessionError is not null)
{
    <div class="text-danger small mb-2" data-testid="delete-session-error">@_deleteSessionError</div>
}

@if (_addPhaseError is not null)
{
    <div class="text-danger small mb-2" data-testid="add-phase-error">@_addPhaseError</div>
}

@if (_loadError is not null)
{
    <div class="text-danger small mb-2" data-testid="load-programs-error">@_loadError</div>
}

<div class="sheet-wrap">
    <table class="table sheet">
        <colgroup>
            <col class="c-name" />
            <col class="c-type" />
            <col class="c-count" />
            <col class="c-weight" />
            <col class="c-sets" />
            <col class="c-rest" />
            <col class="c-side" />
            <col class="c-actions" />
        </colgroup>
        <thead>
            <tr>
                <th class="col-name">Name</th>
                <th>Type</th>
                <th>Reps / Duration</th>
                <th>Weight</th>
                <th>Sets</th>
                <th>Rest (s)</th>
                <th>Side</th>
                <th class="col-actions"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr class="row-depth-0">
                    <td colspan="8">
                        <div class="name-cell">
                            <button
                                class="btn btn-sm btn-icon chevron-btn"
                                data-testid="chevron-@row.Id"
                                title="@ChevronTitle(row)"
                                aria-expanded="@(HasToggleableContent(row) && !_collapsedIds.Contains(row.Id) ? "true" : "false")"
                                disabled="@(!HasToggleableContent(row))"
                                @onclick="() => ToggleCollapsed(row)"
                            >
                                <i
                                    class="bi bi-chevron-down @(HasToggleableContent(row) && _collapsedIds.Contains(row.Id) ? "chevron-collapsed" : "")"
                                    aria-hidden="true"
                                ></i>
                                <span class="visually-hidden">@ChevronTitle(row)</span>
                            </button>
                            <input
                                class="cell-input"
                                data-testid="name-input-@row.Id"
                                value="@row.Name"
                                autofocus="@(row.Id == _editingId)"
                                disabled="@row.IsSaving"
                                @oninput="e => row.Name = (string)e.Value!"
                                @onkeydown="e => OnProgramNameKeyDownAsync(e, row)" />
                            <div class="name-actions">
                                @if (row.IsDirty)
                                {
                                    <button
                                        class="btn btn-sm btn-icon btn-outline-dark"
                                        data-testid="save-@row.Id"
                                        title="Save"
                                        disabled="@row.IsSaving"
                                        @onclick="() => RenameAsync(row)"
                                    >
                                        <i class="bi bi-floppy" aria-hidden="true"></i>
                                        <span class="visually-hidden">Save</span>
                                    </button>
                                    <button
                                        class="btn btn-sm btn-icon btn-outline-secondary"
                                        data-testid="revert-@row.Id"
                                        title="Revert"
                                        disabled="@row.IsSaving"
                                        @onclick="() => Revert(row)"
                                    >
                                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                        <span class="visually-hidden">Revert</span>
                                    </button>
                                }
                                <button
                                    class="btn btn-sm btn-icon btn-outline-dark"
                                    data-testid="add-session-@row.Id"
                                    title="Add Session"
                                    @onclick="() => AddSessionAsync(row)"
                                >
                                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                    <span class="visually-hidden">Add Session</span>
                                </button>
                                <button
                                    class="btn btn-sm btn-icon btn-outline-danger"
                                    data-testid="delete-@row.Id"
                                    title="Delete"
                                    @onclick="() => DeleteAsync(row)"
                                >
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                    <span class="visually-hidden">Delete</span>
                                </button>
                            </div>
                        </div>
                        @if (row.Error is not null)
                        {
                            <div class="text-danger small" data-testid="name-error-@row.Id">
                                @row.Error
                            </div>
                        }
                    </td>
                </tr>
                @if (!_collapsedIds.Contains(row.Id))
                {
                    @if (row.SessionsLoadError is not null)
                    {
                        <tr>
                            <td colspan="8">
                                <div
                                    class="text-danger small"
                                    data-testid="sessions-load-error-@row.Id"
                                >
                                    @row.SessionsLoadError
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var session in row.Sessions)
                    {
                        <tr class="row-depth-1">
                            <td colspan="8">
                                <div class="name-cell">
                                    <button
                                        class="btn btn-sm btn-icon chevron-btn"
                                        data-testid="session-chevron-@session.Id"
                                        title="@SessionChevronTitle(session)"
                                        aria-expanded="@(HasToggleablePhaseContent(session) && !_collapsedSessionIds.Contains(session.Id) ? "true" : "false")"
                                        disabled="@(!HasToggleablePhaseContent(session))"
                                        @onclick="() => ToggleCollapsedSession(session)"
                                    >
                                        <i
                                            class="bi bi-chevron-down @(HasToggleablePhaseContent(session) && _collapsedSessionIds.Contains(session.Id) ? "chevron-collapsed" : "")"
                                            aria-hidden="true"
                                        ></i>
                                        <span class="visually-hidden">@SessionChevronTitle(session)</span>
                                    </button>
                                    <input
                                        class="cell-input"
                                        data-testid="session-name-input-@session.Id"
                                        value="@session.Name"
                                        autofocus="@(session.Id == _editingSessionId)"
                                        disabled="@session.IsSaving"
                                        @oninput="e => session.Name = (string)e.Value!"
                                        @onkeydown="e => OnSessionNameKeyDownAsync(e, session)" />
                                    <div class="name-actions">
                                        @if (session.IsDirty)
                                        {
                                            <button
                                                class="btn btn-sm btn-icon btn-outline-dark"
                                                data-testid="session-save-@session.Id"
                                                title="Save"
                                                disabled="@session.IsSaving"
                                                @onclick="() => RenameSessionAsync(session)"
                                            >
                                                <i class="bi bi-floppy" aria-hidden="true"></i>
                                                <span class="visually-hidden">Save</span>
                                            </button>
                                            <button
                                                class="btn btn-sm btn-icon btn-outline-secondary"
                                                data-testid="session-revert-@session.Id"
                                                title="Revert"
                                                disabled="@session.IsSaving"
                                                @onclick="() => RevertSession(session)"
                                            >
                                                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                                <span class="visually-hidden">Revert</span>
                                            </button>
                                        }
                                        <button
                                            class="btn btn-sm btn-icon btn-outline-dark"
                                            data-testid="add-phase-@session.Id"
                                            title="Add Phase"
                                            @onclick="() => ShowAddPhasePicker(session)"
                                        >
                                            <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                            <span class="visually-hidden">Add Phase</span>
                                        </button>
                                        <button
                                            class="btn btn-sm btn-icon btn-outline-danger"
                                            data-testid="session-delete-@session.Id"
                                            title="Delete"
                                            @onclick="() => DeleteSessionAsync(row, session)"
                                        >
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                            <span class="visually-hidden">Delete</span>
                                        </button>
                                    </div>
                                </div>
                                @if (session.Error is not null)
                                {
                                    <div
                                        class="text-danger small"
                                        data-testid="session-name-error-@session.Id"
                                    >
                                        @session.Error
                                    </div>
                                }
                                @if (_addingPhaseSessionId == session.Id)
                                {
                                    @if (_phaseLibraryLoadError is not null)
                                    {
                                        <div
                                            class="text-danger small"
                                            data-testid="phase-library-load-error-@session.Id"
                                        >
                                            @_phaseLibraryLoadError
                                        </div>
                                    }
                                    else if (_phaseLibrary.Count == 0)
                                    {
                                        <div
                                            class="text-muted small"
                                            data-testid="empty-phase-library-@session.Id"
                                        >
                                            No phases yet -- create one on the
                                            <NavLink href="phases">Phases</NavLink> page first.
                                        </div>
                                    }
                                    else
                                    {
                                        <select
                                            class="form-select form-select-sm w-auto d-inline-block"
                                            data-testid="phase-picker-@session.Id"
                                            @onchange="e => AddPhaseAsync(session, (string)e.Value!)"
                                        >
                                            <option value="">-- Select a phase --</option>
                                            @foreach (var phase in _phaseLibrary)
                                            {
                                                <option value="@phase.Id">@phase.Name</option>
                                            }
                                        </select>
                                    }
                                }
                            </td>
                        </tr>
                        @if (!_collapsedSessionIds.Contains(session.Id))
                        {
                            @if (session.PhasesLoadError is not null)
                            {
                                <tr>
                                    <td colspan="8">
                                        <div
                                            class="text-danger small"
                                            data-testid="phases-load-error-@session.Id"
                                        >
                                            @session.PhasesLoadError
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var phase in session.Phases)
                            {
                                <tr class="row-depth-2">
                                    <td colspan="8">
                                        <div class="name-cell">
                                            <button
                                                class="btn btn-sm btn-icon chevron-btn"
                                                data-testid="phase-chevron-@phase.Id"
                                                title="@PhaseChevronTitle(phase)"
                                                aria-expanded="@(HasToggleableExerciseContent(phase) && !_collapsedSessionPhaseIds.Contains(phase.Id) ? "true" : "false")"
                                                disabled="@(!HasToggleableExerciseContent(phase))"
                                                @onclick="() => ToggleCollapsedSessionPhase(phase)"
                                            >
                                                <i
                                                    class="bi bi-chevron-down @(HasToggleableExerciseContent(phase) && _collapsedSessionPhaseIds.Contains(phase.Id) ? "chevron-collapsed" : "")"
                                                    aria-hidden="true"
                                                ></i>
                                                <span class="visually-hidden">@PhaseChevronTitle(phase)</span>
                                            </button>
                                            <span data-testid="phase-name-@phase.Id">@phase.DisplayName</span>
                                            <div class="name-actions">
                                                <button
                                                    class="btn btn-sm btn-icon btn-outline-dark"
                                                    data-testid="add-exercise-@phase.Id"
                                                    title="Add Exercise"
                                                    disabled="@(_submittingAddExercisePhaseId is not null)"
                                                    @onclick="() => ShowAddExercisePicker(phase)"
                                                >
                                                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Add Exercise</span>
                                                </button>
                                                <button
                                                    class="btn btn-sm btn-icon btn-outline-danger"
                                                    data-testid="phase-delete-@phase.Id"
                                                    title="Delete"
                                                    @onclick="() => DeleteSessionPhaseAsync(session, phase)"
                                                >
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Delete</span>
                                                </button>
                                            </div>
                                        </div>
                                        @if (phase.Error is not null)
                                        {
                                            <div
                                                class="text-danger small"
                                                data-testid="phase-error-@phase.Id"
                                            >
                                                @phase.Error
                                            </div>
                                        }
                                        @if (phase.AddExerciseError is not null)
                                        {
                                            <div
                                                class="text-danger small"
                                                data-testid="add-exercise-error-@phase.Id"
                                            >
                                                @phase.AddExerciseError
                                            </div>
                                        }
                                        @if (_addingExerciseSessionPhaseId == phase.Id)
                                        {
                                            @if (_exerciseLibraryLoadError is not null)
                                            {
                                                <div
                                                    class="text-danger small"
                                                    data-testid="exercise-library-load-error-@phase.Id"
                                                >
                                                    @_exerciseLibraryLoadError
                                                </div>
                                            }
                                            else if (_exerciseLibrary.Count == 0)
                                            {
                                                <div
                                                    class="text-muted small"
                                                    data-testid="empty-exercise-library-@phase.Id"
                                                >
                                                    No exercises yet -- create one on the
                                                    <NavLink href="exercises">Exercises</NavLink> page first.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                                                    <select
                                                        class="form-select form-select-sm w-auto"
                                                        data-testid="exercise-picker-@phase.Id"
                                                        disabled="@phase.IsAddingExercise"
                                                        @onchange="e => _addExerciseExerciseId = (string)e.Value!"
                                                    >
                                                        <option value="">-- Select an exercise --</option>
                                                        @foreach (var exercise in _exerciseLibrary)
                                                        {
                                                            <option value="@exercise.Id">@exercise.Name</option>
                                                        }
                                                    </select>
                                                    <select
                                                        class="form-select form-select-sm w-auto"
                                                        data-testid="exercise-type-@phase.Id"
                                                        disabled="@phase.IsAddingExercise"
                                                        @onchange="e => _addExerciseType = (string)e.Value!"
                                                    >
                                                        <option value="Reps">Reps</option>
                                                        <option value="Timed">Timed</option>
                                                    </select>
                                                    <input
                                                        type="number"
                                                        class="form-control form-control-sm w-auto"
                                                        placeholder="@(_addExerciseType == "Timed" ? "Duration (s)" : "Reps")"
                                                        data-testid="exercise-count-@phase.Id"
                                                        disabled="@phase.IsAddingExercise"
                                                        @oninput="e => _addExerciseCount = ParseNullableInt(e.Value)"
                                                        @onkeydown="e => OnAddExerciseKeyDownAsync(e, session, phase)" />
                                                    <input
                                                        type="number"
                                                        class="form-control form-control-sm w-auto"
                                                        placeholder="Sets"
                                                        data-testid="exercise-sets-@phase.Id"
                                                        disabled="@phase.IsAddingExercise"
                                                        @oninput="e => _addExerciseSets = ParseNullableInt(e.Value)"
                                                        @onkeydown="e => OnAddExerciseKeyDownAsync(e, session, phase)" />
                                                    <input
                                                        type="number"
                                                        class="form-control form-control-sm w-auto"
                                                        placeholder="Rest (s)"
                                                        data-testid="exercise-restseconds-@phase.Id"
                                                        disabled="@phase.IsAddingExercise"
                                                        @oninput="e => _addExerciseRestSeconds = ParseNullableInt(e.Value)"
                                                        @onkeydown="e => OnAddExerciseKeyDownAsync(e, session, phase)" />
                                                    <button
                                                        class="btn btn-sm btn-dark"
                                                        data-testid="add-exercise-submit-@phase.Id"
                                                        disabled="@(!CanSubmitAddExercise || phase.IsAddingExercise)"
                                                        @onclick="() => AddProgramExerciseAsync(session, phase)"
                                                    >
                                                        Add
                                                    </button>
                                                </div>
                                            }
                                        }
                                    </td>
                                </tr>
                                @if (!_collapsedSessionPhaseIds.Contains(phase.Id))
                                {
                                    @if (phase.ProgramExercisesLoadError is not null)
                                    {
                                        <tr>
                                            <td colspan="8">
                                                <div
                                                    class="text-danger small"
                                                    data-testid="program-exercises-load-error-@phase.Id"
                                                >
                                                    @phase.ProgramExercisesLoadError
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var programExercise in phase.ProgramExercises)
                                    {
                                        <tr class="row-depth-3">
                                            <td>
                                                <div class="name-cell">
                                                    <span class="chevron-spacer"></span>
                                                    <span data-testid="program-exercise-name-@programExercise.Id">
                                                        @programExercise.ExerciseName
                                                    </span>
                                                </div>
                                                @if (programExercise.Error is not null)
                                                {
                                                    <div
                                                        class="text-danger small"
                                                        data-testid="program-exercise-error-@programExercise.Id"
                                                    >
                                                        @programExercise.Error
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge text-bg-secondary" data-testid="program-exercise-type-@programExercise.Id">
                                                    @(programExercise.IsTimed ? "Timed" : "Reps")
                                                </span>
                                            </td>
                                            <td>
                                                <input
                                                    type="number"
                                                    class="cell-input"
                                                    data-testid="program-exercise-count-@programExercise.Id"
                                                    value="@programExercise.Count"
                                                    disabled="@programExercise.IsSaving"
                                                    @oninput="e => programExercise.Count = ParseInt(e.Value)"
                                                    @onkeydown="e => OnProgramExerciseKeyDownAsync(e, session, phase, programExercise)" />
                                            </td>
                                            <td>
                                                <input
                                                    type="text"
                                                    class="cell-input"
                                                    data-testid="program-exercise-weight-@programExercise.Id"
                                                    value="@programExercise.WeightText"
                                                    disabled="@programExercise.IsSaving"
                                                    @oninput="e => SetWeight(programExercise, (string?)e.Value)"
                                                    @onkeydown="e => OnProgramExerciseKeyDownAsync(e, session, phase, programExercise)" />
                                            </td>
                                            <td>
                                                <input
                                                    type="number"
                                                    class="cell-input"
                                                    data-testid="program-exercise-sets-@programExercise.Id"
                                                    value="@programExercise.Sets"
                                                    disabled="@programExercise.IsSaving"
                                                    @oninput="e => programExercise.Sets = ParseInt(e.Value)"
                                                    @onkeydown="e => OnProgramExerciseKeyDownAsync(e, session, phase, programExercise)" />
                                            </td>
                                            <td>
                                                <input
                                                    type="number"
                                                    class="cell-input"
                                                    data-testid="program-exercise-rest-@programExercise.Id"
                                                    value="@programExercise.RestSeconds"
                                                    disabled="@programExercise.IsSaving"
                                                    @oninput="e => programExercise.RestSeconds = ParseInt(e.Value)"
                                                    @onkeydown="e => OnProgramExerciseKeyDownAsync(e, session, phase, programExercise)" />
                                            </td>
                                            <td>
                                                <select
                                                    class="form-select form-select-sm cell-input"
                                                    data-testid="program-exercise-side-@programExercise.Id"
                                                    disabled="@programExercise.IsSaving"
                                                    @onchange="e => programExercise.Side = Enum.Parse<ProgramExerciseSide>((string)e.Value!)"
                                                >
                                                    @foreach (var side in Enum.GetValues<ProgramExerciseSide>())
                                                    {
                                                        <option value="@side" selected="@(side == programExercise.Side)">@side</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <div class="name-actions">
                                                    @if (programExercise.IsDirty)
                                                    {
                                                        <button
                                                            class="btn btn-sm btn-icon btn-outline-dark"
                                                            data-testid="program-exercise-save-@programExercise.Id"
                                                            title="Save"
                                                            disabled="@programExercise.IsSaving"
                                                            @onclick="() => SaveProgramExerciseAsync(session, phase, programExercise)"
                                                        >
                                                            <i class="bi bi-floppy" aria-hidden="true"></i>
                                                            <span class="visually-hidden">Save</span>
                                                        </button>
                                                        <button
                                                            class="btn btn-sm btn-icon btn-outline-secondary"
                                                            data-testid="program-exercise-revert-@programExercise.Id"
                                                            title="Revert"
                                                            disabled="@programExercise.IsSaving"
                                                            @onclick="() => RevertProgramExercise(programExercise)"
                                                        >
                                                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                                            <span class="visually-hidden">Revert</span>
                                                        </button>
                                                    }
                                                    <button
                                                        class="btn btn-sm btn-icon btn-outline-danger"
                                                        data-testid="program-exercise-delete-@programExercise.Id"
                                                        title="Delete"
                                                        @onclick="() => DeleteProgramExerciseAsync(session, phase, programExercise)"
                                                    >
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                        <span class="visually-hidden">Delete</span>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>

@code {
    private readonly List<ProgramRow> _rows = [];
    private readonly HashSet<ProgramId> _collapsedIds = [];
    private readonly HashSet<SessionId> _collapsedSessionIds = [];
    private readonly HashSet<SessionPhaseId> _collapsedSessionPhaseIds = [];
    private readonly List<PhaseSummary> _phaseLibrary = [];
    private readonly List<ExerciseSummary> _exerciseLibrary = [];
    private string? _phaseLibraryLoadError;
    private string? _exerciseLibraryLoadError;
    private ProgramId? _editingId;
    private SessionId? _editingSessionId;
    private SessionId? _addingPhaseSessionId;
    private SessionPhaseId? _addingExerciseSessionPhaseId;
    private SessionPhaseId? _submittingAddExercisePhaseId;
    private string _addExerciseExerciseId = "";
    private string _addExerciseType = "Reps";
    private int? _addExerciseCount;
    private int? _addExerciseSets;
    private int? _addExerciseRestSeconds;
    private string? _addProgramError;
    private string? _addSessionError;
    private string? _addPhaseError;
    private string? _deleteError;
    private string? _deleteSessionError;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _phaseLibrary.AddRange(await PhasesApi.GetPhasesAsync());
        }
        catch (Exception ex)
            when (ex
                is HttpRequestException
                    or JsonException
                    or InvalidOperationException
                    or NotSupportedException
                    or OperationCanceledException
            )
        {
            _phaseLibraryLoadError = "Could not load phases. Try refreshing the page.";
            LogLoadPhaseLibraryFailed(Logger, ex);
        }

        try
        {
            _exerciseLibrary.AddRange(await ExercisesApi.GetExercisesAsync());
        }
        catch (Exception ex)
            when (ex
                is HttpRequestException
                    or JsonException
                    or InvalidOperationException
                    or NotSupportedException
                    or OperationCanceledException
            )
        {
            _exerciseLibraryLoadError = "Could not load exercises. Try refreshing the page.";
            LogLoadExerciseLibraryFailed(Logger, ex);
        }

        try
        {
            var programs = await Api.GetProgramsAsync();
            foreach (var program in programs)
            {
                var row = new ProgramRow(program.Id, program.Name);
                _rows.Add(row);
                await LoadSessionsAsync(row, program.Id);
            }
        }
        // HttpRequestException alone was not enough: Cloudflare Access answers a request made
        // before the session is established with its own HTML login page, which arrives as a
        // JsonException and escaped, blanking the page instead of showing the load error.
        // The charset and content-type cases come with it; a timeout arrives as a cancellation.
        catch (Exception ex)
            when (ex
                    is HttpRequestException
                        or JsonException
                        or InvalidOperationException
                        or NotSupportedException
                        or OperationCanceledException
            )
        {
            _loadError = "Could not load programs. Try refreshing the page.";
            LogLoadProgramsFailed(Logger, ex);
        }
    }

    private async Task LoadSessionsAsync(ProgramRow row, ProgramId programId)
    {
        try
        {
            var sessions = await SessionsApi.GetSessionsAsync(programId);
            foreach (var session in sessions)
            {
                var sessionRow = new SessionRow(session.Id, programId, session.Name);
                row.Sessions.Add(sessionRow);
                await LoadSessionPhasesAsync(sessionRow, programId, session.Id);
            }
        }
        catch (Exception ex)
            when (ex
                is HttpRequestException
                    or JsonException
                    or InvalidOperationException
                    or NotSupportedException
                    or OperationCanceledException
            )
        {
            row.SessionsLoadError = "Could not load sessions. Try refreshing the page.";
            LogLoadSessionsForProgramFailed(Logger, programId, ex);
        }
    }

    private async Task LoadSessionPhasesAsync(
        SessionRow sessionRow,
        ProgramId programId,
        SessionId sessionId
    )
    {
        try
        {
            var sessionPhases = await SessionPhasesApi.GetSessionPhasesAsync(programId, sessionId);
            foreach (var sessionPhase in sessionPhases)
            {
                var sessionPhaseRow = new SessionPhaseRow(
                    sessionPhase.Id,
                    sessionPhase.PhaseId,
                    ResolvePhaseName(sessionPhase.PhaseId)
                );
                sessionRow.Phases.Add(sessionPhaseRow);
                await LoadProgramExercisesAsync(sessionPhaseRow, programId, sessionId, sessionPhase.Id);
            }
        }
        catch (Exception ex)
            when (ex
                is HttpRequestException
                    or JsonException
                    or InvalidOperationException
                    or NotSupportedException
                    or OperationCanceledException
            )
        {
            sessionRow.PhasesLoadError = "Could not load phases. Try refreshing the page.";
            LogLoadPhasesForSessionFailed(Logger, sessionId, ex);
        }
    }

    private async Task LoadProgramExercisesAsync(
        SessionPhaseRow sessionPhaseRow,
        ProgramId programId,
        SessionId sessionId,
        SessionPhaseId sessionPhaseId
    )
    {
        try
        {
            var programExercises = await ProgramExercisesApi.GetProgramExercisesAsync(
                programId,
                sessionId,
                sessionPhaseId
            );
            sessionPhaseRow.ProgramExercises.AddRange(
                programExercises.Select(pe => new ProgramExerciseRow(
                    pe,
                    ResolveExerciseName(pe.ExerciseId)
                ))
            );
        }
        catch (Exception ex)
            when (ex
                is HttpRequestException
                    or JsonException
                    or InvalidOperationException
                    or NotSupportedException
                    or OperationCanceledException
                    or FormatException
                    or ArgumentException
            )
        {
            sessionPhaseRow.ProgramExercisesLoadError =
                "Could not load exercises. Try refreshing the page.";
            LogLoadProgramExercisesForSessionPhaseFailed(Logger, sessionPhaseId, ex);
        }
    }

