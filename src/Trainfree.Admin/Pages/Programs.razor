@page "/programs"
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Trainfree.Admin.Admin
@using Trainfree.Domain.Ids
@using Trainfree.Domain.ProgramExercises
@inject IProgramsApiClient Api
@inject IProgramTreeApiClient TreeApi
@inject ISessionsApiClient SessionsApi
@inject IPhasesApiClient PhasesApi
@inject ISessionPhasesApiClient SessionPhasesApi
@inject IExercisesApiClient ExercisesApi
@inject IProgramExercisesApiClient ProgramExercisesApi
@inject ILogger<Programs> Logger

<PageTitle>Programs - Trainfree Admin</PageTitle>

<div class="page-header d-flex align-items-end justify-content-between flex-wrap gap-3">
    <div>
        <h1>Programs</h1>
        <p class="page-sub mb-0">
            Build out programs and sessions for your workouts.
        </p>
    </div>
    <AddButton TestId="add-program" Label="Add Program" OnClick="AddProgramAsync" />
</div>

<InlineError Message="@_addProgramError" TestId="add-program-error" Class="mb-2" />
<InlineError Message="@_addSessionError" TestId="add-session-error" Class="mb-2" />
<InlineError Message="@_deleteError" TestId="delete-program-error" Class="mb-2" />
<InlineError Message="@_deleteSessionError" TestId="delete-session-error" Class="mb-2" />
<InlineError Message="@_addPhaseError" TestId="add-phase-error" Class="mb-2" />
<InlineError Message="@_loadError" TestId="load-programs-error" Class="mb-2" />

<div class="sheet-wrap">
    <table class="table sheet">
        <colgroup>
            <col class="c-name" />
            <col class="c-type" />
            <col class="c-count" />
            <col class="c-weight" />
            <col class="c-sets" />
            <col class="c-rest" />
            <col class="c-side" />
            <col class="c-actions" />
        </colgroup>
        <thead>
            <tr>
                <th class="col-name">Name</th>
                <th>Type</th>
                <th>Reps / Duration</th>
                <th>Weight</th>
                <th>Sets</th>
                <th>Rest (s)</th>
                <th>Side</th>
                <th class="col-actions"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <ProgramTableRow
                    Row="row"
                    IsCollapsed="@_collapsedIds.Contains(row.Id)"
                    IsEditing="@(row.Id == _editingId)"
                    ChevronTitle="@ChevronTitle(row)"
                    HasToggleableContent="@HasToggleableContent(row)"
                    OnToggle="() => ToggleCollapsed(row)"
                    OnSave="() => RenameAsync(row)"
                    OnRevert="() => Revert(row)"
                    OnAddSession="() => AddSessionAsync(row)"
                    OnDelete="() => DeleteAsync(row)"
                />
                @if (!_collapsedIds.Contains(row.Id))
                {
                    @foreach (var session in row.Sessions)
                    {
                        <SessionTableRow
                            Session="session"
                            IsCollapsed="@_collapsedSessionIds.Contains(session.Id)"
                            IsEditing="@(session.Id == _editingSessionId)"
                            ChevronTitle="@SessionChevronTitle(session)"
                            HasToggleableContent="@HasToggleablePhaseContent(session)"
                            IsAddingPhase="@(_addingPhaseSessionId == session.Id)"
                            PhaseLibraryLoadError="@_phaseLibraryLoadError"
                            PhaseLibrary="_phaseLibrary"
                            OnToggle="() => ToggleCollapsedSession(session)"
                            OnSave="() => RenameSessionAsync(session)"
                            OnRevert="() => RevertSession(session)"
                            OnAddPhase="() => ShowAddPhasePicker(session)"
                            OnDelete="() => DeleteSessionAsync(row, session)"
                            OnPhaseSelected="phaseId => AddPhaseAsync(session, phaseId)"
                        />
                        @if (!_collapsedSessionIds.Contains(session.Id))
                        {
                            @foreach (var phase in session.Phases)
                            {
                                <SessionPhaseTableRow
                                    Phase="phase"
                                    IsCollapsed="@_collapsedSessionPhaseIds.Contains(phase.Id)"
                                    ChevronTitle="@PhaseChevronTitle(phase)"
                                    HasToggleableContent="@HasToggleableExerciseContent(phase)"
                                    IsAddExerciseDisabled="@(_submittingAddExercisePhaseId is not null)"
                                    IsAddingExercise="@(_addingExerciseSessionPhaseId == phase.Id)"
                                    ExerciseLibraryLoadError="@_exerciseLibraryLoadError"
                                    ExerciseLibrary="_exerciseLibrary"
                                    OnToggle="() => ToggleCollapsedSessionPhase(phase)"
                                    OnAddExercise="() => ShowAddExercisePicker(phase)"
                                    OnDelete="() => DeleteSessionPhaseAsync(session, phase)"
                                    OnSubmitExercise="submission => AddProgramExerciseAsync(session, phase, submission)"
                                />
                                @if (!_collapsedSessionPhaseIds.Contains(phase.Id))
                                {
                                    @foreach (var programExercise in phase.ProgramExercises)
                                    {
                                        <ProgramExerciseTableRow
                                            Row="programExercise"
                                            OnSave="() => SaveProgramExerciseAsync(session, phase, programExercise)"
                                            OnDuplicate="() => DuplicateProgramExerciseAsync(session, phase, programExercise)"
                                            OnDelete="() => DeleteProgramExerciseAsync(session, phase, programExercise)"
                                        />
                                    }
                                }
                            }
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>

@code {
    private readonly List<ProgramRow> _rows = [];
    private readonly HashSet<ProgramId> _collapsedIds = [];
    private readonly HashSet<SessionId> _collapsedSessionIds = [];
    private readonly HashSet<SessionPhaseId> _collapsedSessionPhaseIds = [];
    private readonly List<PhaseSummary> _phaseLibrary = [];
    private readonly List<ExerciseSummary> _exerciseLibrary = [];
    private string? _phaseLibraryLoadError;
    private string? _exerciseLibraryLoadError;
    private ProgramId? _editingId;
    private SessionId? _editingSessionId;
    private SessionId? _addingPhaseSessionId;
    private SessionPhaseId? _addingExerciseSessionPhaseId;
    private SessionPhaseId? _submittingAddExercisePhaseId;
    private string? _addProgramError;
    private string? _addSessionError;
    private string? _addPhaseError;
    private string? _deleteError;
    private string? _deleteSessionError;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _phaseLibrary.AddRange(
                (await PhasesApi.GetPhasesAsync()).OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            );
        }
        catch (Exception ex)
            when (ex
                is HttpRequestException
                    or JsonException
                    or InvalidOperationException
                    or NotSupportedException
                    or OperationCanceledException
            )
        {
            _phaseLibraryLoadError = "Could not load phases. Try refreshing the page.";
            LogLoadPhaseLibraryFailed(Logger, ex);
        }

        try
        {
            _exerciseLibrary.AddRange(
                (await ExercisesApi.GetExercisesAsync()).OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
            );
        }
        catch (Exception ex)
            when (ex
                is HttpRequestException
                    or JsonException
                    or InvalidOperationException
                    or NotSupportedException
                    or OperationCanceledException
            )
        {
            _exerciseLibraryLoadError = "Could not load exercises. Try refreshing the page.";
            LogLoadExerciseLibraryFailed(Logger, ex);
        }

        try
        {
            var programTree = await TreeApi.GetProgramTreeAsync();
            foreach (var programItem in programTree)
            {
                _rows.Add(BuildProgramRow(programItem));
            }
        }
        // HttpRequestException alone was not enough: Cloudflare Access answers a request made
        // before the session is established with its own HTML login page, which arrives as a
        // JsonException and escaped, blanking the page instead of showing the load error.
        // The charset and content-type cases come with it; a timeout arrives as a cancellation.
        // FormatException/ArgumentException cover a program exercise row whose type or side
        // doesn't parse -- GetProgramTreeAsync maps every row eagerly rather than lazily, so
        // that surfaces here rather than later when a lazily-evaluated row is enumerated.
        catch (Exception ex)
            when (ex
                    is HttpRequestException
                        or JsonException
                        or InvalidOperationException
                        or NotSupportedException
                        or OperationCanceledException
                        or FormatException
                        or ArgumentException
            )
        {
            _loadError = "Could not load programs. Try refreshing the page.";
            LogLoadProgramTreeFailed(Logger, ex);
        }
    }

    private ProgramRow BuildProgramRow(ProgramTreeItem programItem)
    {
        var row = new ProgramRow(programItem.Program.Id, programItem.Program.Name);
        foreach (var sessionItem in programItem.Sessions)
        {
            row.AddSession(BuildSessionRow(sessionItem));
        }
        return row;
    }

    private SessionRow BuildSessionRow(SessionTreeItem sessionItem)
    {
        var sessionRow = new SessionRow(
            sessionItem.Session.Id,
            sessionItem.Session.ProgramId,
            sessionItem.Session.Name
        );
        foreach (var phaseItem in sessionItem.Phases)
        {
            sessionRow.AddPhase(BuildSessionPhaseRow(phaseItem));
        }
        return sessionRow;
    }

    private SessionPhaseRow BuildSessionPhaseRow(SessionPhaseTreeItem phaseItem)
    {
        var sessionPhaseRow = new SessionPhaseRow(
            phaseItem.SessionPhase.Id,
            phaseItem.SessionPhase.PhaseId,
            ResolvePhaseName(phaseItem.SessionPhase.PhaseId)
        );
        sessionPhaseRow.AddProgramExercises(
            phaseItem.Exercises.Select(pe => new ProgramExerciseRow(pe, ResolveExerciseName(pe.ExerciseId)))
        );
        return sessionPhaseRow;
    }

    private static bool HasToggleableContent(ProgramRow row) => row.Sessions.Count > 0;

    private bool HasOpenAddExerciseForm(SessionRow session) =>
        _addingExerciseSessionPhaseId is not null
        && _exerciseLibraryLoadError is null
        && _exerciseLibrary.Count > 0
        && session.Phases.Any(phase => phase.Id == _addingExerciseSessionPhaseId);

    private bool HasOpenAddExerciseForm(ProgramRow row) => row.Sessions.Any(HasOpenAddExerciseForm);

    private string ChevronTitle(ProgramRow row)
    {
        if (!HasToggleableContent(row))
        {
            return "No sessions";
        }

        if (!_collapsedIds.Contains(row.Id) && HasOpenAddExerciseForm(row))
        {
            return "Finish adding the exercise before collapsing";
        }

        return _collapsedIds.Contains(row.Id) ? "Expand" : "Collapse";
    }

    private void ToggleCollapsed(ProgramRow row)
    {
        if (!HasToggleableContent(row))
        {
            return;
        }

        if (!_collapsedIds.Contains(row.Id) && HasOpenAddExerciseForm(row))
        {
            return;
        }

        if (!_collapsedIds.Add(row.Id))
        {
            _collapsedIds.Remove(row.Id);
        }
    }

    private string ResolvePhaseName(PhaseId phaseId) =>
        _phaseLibrary.FirstOrDefault(p => p.Id == phaseId)?.Name ?? phaseId.Value;

    private string ResolveExerciseName(ExerciseId exerciseId) =>
        _exerciseLibrary.FirstOrDefault(e => e.Id == exerciseId)?.Name ?? exerciseId.Value;

    private static bool HasToggleableExerciseContent(SessionPhaseRow phase) =>
        phase.ProgramExercises.Count > 0;

    private string PhaseChevronTitle(SessionPhaseRow phase)
    {
        if (!HasToggleableExerciseContent(phase))
        {
            return "No exercises";
        }

        return _collapsedSessionPhaseIds.Contains(phase.Id) ? "Expand" : "Collapse";
    }

    private void ToggleCollapsedSessionPhase(SessionPhaseRow phase)
    {
        if (!HasToggleableExerciseContent(phase))
        {
            return;
        }

        if (!_collapsedSessionPhaseIds.Add(phase.Id))
        {
            _collapsedSessionPhaseIds.Remove(phase.Id);
        }
    }

    private void ShowAddExercisePicker(SessionPhaseRow phase)
    {
        if (_submittingAddExercisePhaseId is not null)
        {
            return;
        }

        _addingExerciseSessionPhaseId = phase.Id;
        phase.AddExerciseError = null;
        phase.AddExerciseFormGeneration++;
    }

    private async Task AddProgramExerciseAsync(
        SessionRow session,
        SessionPhaseRow phase,
        AddProgramExerciseFormSubmission submission
    )
    {
        if (phase.IsAddingExercise)
        {
            return;
        }

        phase.IsAddingExercise = true;
        _submittingAddExercisePhaseId = phase.Id;
        try
        {
            var prescription = new SetPrescription(submission.Sets, submission.RestSeconds);
            var outcome = submission.IsTimed
                ? await ProgramExercisesApi.CreateTimedProgramExerciseAsync(
                    session.ProgramId,
                    session.Id,
                    phase.Id,
                    submission.ExerciseId,
                    submission.Count,
                    prescription
                )
                : await ProgramExercisesApi.CreateRepsProgramExerciseAsync(
                    session.ProgramId,
                    session.Id,
                    phase.Id,
                    submission.ExerciseId,
                    submission.Count,
                    prescription
                );

            switch (outcome)
            {
                case CreateProgramExerciseSucceeded succeeded:
                    phase.AddProgramExercise(
                        new ProgramExerciseRow(
                            succeeded.ProgramExercise,
                            ResolveExerciseName(succeeded.ProgramExercise.ExerciseId)
                        )
                    );
                    if (_addingExerciseSessionPhaseId == phase.Id)
                    {
                        _addingExerciseSessionPhaseId = null;
                    }

                    phase.AddExerciseError = null;
                    _collapsedSessionPhaseIds.Remove(phase.Id);
                    break;
                case CreateProgramExerciseFailed failed:
                    phase.AddExerciseError = failed.Error;
                    break;
            }
        }
        finally
        {
            phase.IsAddingExercise = false;
            if (_submittingAddExercisePhaseId == phase.Id)
            {
                _submittingAddExercisePhaseId = null;
            }
        }
    }

    private async Task SaveProgramExerciseAsync(
        SessionRow session,
        SessionPhaseRow phase,
        ProgramExerciseRow row
    )
    {
        if (row.IsSaving)
        {
            return;
        }

        if (row.Count <= 0 || row.Sets <= 0 || row.RestSeconds <= 0)
        {
            row.Error = "Reps/duration, sets, and rest must be positive.";
            return;
        }

        if (!row.WeightIsValid)
        {
            row.Error = "Weight must be a valid number.";
            return;
        }

        if (row.Weight < 0)
        {
            row.Error = "Weight cannot be negative.";
            return;
        }

        var update = row.IsTimed
            ? new ProgramExerciseUpdate(
                DurationSeconds: row.Count,
                Weight: row.Weight,
                Sets: row.Sets,
                RestSeconds: row.RestSeconds,
                Side: row.Side
            )
            : new ProgramExerciseUpdate(
                Reps: row.Count,
                Weight: row.Weight,
                Sets: row.Sets,
                RestSeconds: row.RestSeconds,
                Side: row.Side
            );

        row.IsSaving = true;
        try
        {
            var outcome = await ProgramExercisesApi.UpdateProgramExerciseAsync(
                session.ProgramId,
                session.Id,
                phase.Id,
                row.Id,
                update
            );
            switch (outcome)
            {
                case UpdateProgramExerciseSucceeded succeeded:
                    row.ApplySaved(succeeded.ProgramExercise);
                    row.Error = null;
                    break;
                case UpdateProgramExerciseFailed failed:
                    row.Error = failed.Error;
                    break;
            }
        }
        finally
        {
            row.IsSaving = false;
        }
    }

    private async Task DuplicateProgramExerciseAsync(
        SessionRow session,
        SessionPhaseRow phase,
        ProgramExerciseRow row
    )
    {
        if (row.IsSaving)
        {
            return;
        }

        row.IsSaving = true;
        try
        {
            var prescription = new SetPrescription(row.SavedSets, row.SavedRestSeconds);
            var createOutcome = row.IsTimed
                ? await ProgramExercisesApi.CreateTimedProgramExerciseAsync(
                    session.ProgramId,
                    session.Id,
                    phase.Id,
                    row.ExerciseId,
                    row.SavedCount,
                    prescription
                )
                : await ProgramExercisesApi.CreateRepsProgramExerciseAsync(
                    session.ProgramId,
                    session.Id,
                    phase.Id,
                    row.ExerciseId,
                    row.SavedCount,
                    prescription
                );

            if (createOutcome is CreateProgramExerciseFailed createFailed)
            {
                row.Error = createFailed.Error;
                return;
            }

            row.Error = null;
            var created = ((CreateProgramExerciseSucceeded)createOutcome).ProgramExercise;
            var newRow = new ProgramExerciseRow(created, ResolveExerciseName(created.ExerciseId));
            phase.AddProgramExercise(newRow);

            var update = new ProgramExerciseUpdate(
                Reps: row.IsTimed ? null : row.SavedCount,
                DurationSeconds: row.IsTimed ? row.SavedCount : null,
                Weight: row.SavedWeight,
                Sets: row.SavedSets,
                RestSeconds: row.SavedRestSeconds,
                Side: row.SavedSide
            );

            newRow.IsSaving = true;
            try
            {
                var updateOutcome = await ProgramExercisesApi.UpdateProgramExerciseAsync(
                    session.ProgramId,
                    session.Id,
                    phase.Id,
                    newRow.Id,
                    update
                );
                switch (updateOutcome)
                {
                    case UpdateProgramExerciseSucceeded succeeded:
                        newRow.ApplySaved(succeeded.ProgramExercise);
                        break;
                    case UpdateProgramExerciseFailed failed:
                        newRow.Error = failed.Error;
                        break;
                }
            }
            finally
            {
                newRow.IsSaving = false;
            }
        }
        finally
        {
            row.IsSaving = false;
        }
    }

    private async Task DeleteProgramExerciseAsync(
        SessionRow session,
        SessionPhaseRow phase,
        ProgramExerciseRow row
    )
    {
        if (row.IsSaving)
        {
            return;
        }

        row.IsSaving = true;
        try
        {
            var outcome = await ProgramExercisesApi.DeleteProgramExerciseAsync(
                session.ProgramId,
                session.Id,
                phase.Id,
                row.Id
            );
            switch (outcome)
            {
                case DeleteProgramExerciseSucceeded:
                    phase.RemoveProgramExercise(row);
                    break;
                case DeleteProgramExerciseFailed failed:
                    row.Error = failed.Error;
                    break;
            }
        }
        finally
        {
            row.IsSaving = false;
        }
    }

    private static bool HasToggleablePhaseContent(SessionRow session) => session.Phases.Count > 0;

    private string SessionChevronTitle(SessionRow session)
    {
        if (!HasToggleablePhaseContent(session))
        {
            return "No phases";
        }

        if (!_collapsedSessionIds.Contains(session.Id) && HasOpenAddExerciseForm(session))
        {
            return "Finish adding the exercise before collapsing";
        }

        return _collapsedSessionIds.Contains(session.Id) ? "Expand" : "Collapse";
    }

    private void ToggleCollapsedSession(SessionRow session)
    {
        if (!HasToggleablePhaseContent(session))
        {
            return;
        }

        if (!_collapsedSessionIds.Contains(session.Id) && HasOpenAddExerciseForm(session))
        {
            return;
        }

        if (!_collapsedSessionIds.Add(session.Id))
        {
            _collapsedSessionIds.Remove(session.Id);
        }
    }

    private void ShowAddPhasePicker(SessionRow session) => _addingPhaseSessionId = session.Id;

    private async Task AddPhaseAsync(SessionRow session, string phaseIdValue)
    {
        if (string.IsNullOrEmpty(phaseIdValue) || !PhaseId.TryParse(phaseIdValue, out var phaseId))
        {
            return;
        }

        var outcome = await SessionPhasesApi.CreateSessionPhaseAsync(
            session.ProgramId,
            session.Id,
            phaseId
        );
        switch (outcome)
        {
            case CreateSessionPhaseSucceeded succeeded:
                session.AddPhase(
                    new SessionPhaseRow(
                        succeeded.SessionPhase.Id,
                        succeeded.SessionPhase.PhaseId,
                        ResolvePhaseName(succeeded.SessionPhase.PhaseId)
                    )
                );
                _addingPhaseSessionId = null;
                _addPhaseError = null;
                _collapsedSessionIds.Remove(session.Id);
                break;
            case CreateSessionPhaseFailed failed:
                _addingPhaseSessionId = null;
                _addPhaseError = failed.Error;
                break;
        }
    }

    private async Task DeleteSessionPhaseAsync(SessionRow session, SessionPhaseRow phase)
    {
        var outcome = await SessionPhasesApi.DeleteSessionPhaseAsync(
            session.ProgramId,
            session.Id,
            phase.Id
        );
        switch (outcome)
        {
            case DeleteSessionPhaseSucceeded:
                session.RemovePhase(phase);
                break;
            case DeleteSessionPhaseFailed failed:
                phase.Error = failed.Error;
                break;
        }
    }

    private async Task AddProgramAsync()
    {
        var outcome = await Api.CreateProgramAsync("New Program");
        switch (outcome)
        {
            case CreateProgramSucceeded succeeded:
                _rows.Add(new ProgramRow(succeeded.Program.Id, succeeded.Program.Name));
                _editingId = succeeded.Program.Id;
                _addProgramError = null;
                break;
            case CreateProgramFailed failed:
                _addProgramError = failed.Error;
                break;
        }
    }

    private const int MinNameLength = 4;
    private const int MaxNameLength = 100;

    private async Task RenameAsync(ProgramRow row)
    {
        if (row.IsSaving)
        {
            return;
        }

        var trimmedLength = row.Name.Trim().Length;
        if (trimmedLength is < MinNameLength or > MaxNameLength)
        {
            row.Error = $"Name must be between {MinNameLength} and {MaxNameLength} characters.";
            return;
        }

        row.IsSaving = true;
        try
        {
            var outcome = await Api.RenameProgramAsync(row.Id, row.Name);
            switch (outcome)
            {
                case RenameProgramSucceeded succeeded:
                    row.Name = succeeded.Program.Name;
                    row.SavedName = succeeded.Program.Name;
                    row.Error = null;
                    break;
                case RenameProgramFailed failed:
                    row.Error = failed.Error;
                    break;
            }
        }
        finally
        {
            row.IsSaving = false;
        }
    }

    private static void Revert(ProgramRow row)
    {
        row.Name = row.SavedName;
        row.Error = null;
    }

    private async Task DeleteAsync(ProgramRow row)
    {
        var outcome = await Api.DeleteProgramAsync(row.Id);
        switch (outcome)
        {
            case DeleteProgramSucceeded:
                _rows.Remove(row);
                _deleteError = null;
                break;
            case DeleteProgramFailed failed:
                _deleteError = failed.Error;
                break;
        }
    }

    private async Task AddSessionAsync(ProgramRow row)
    {
        var outcome = await SessionsApi.CreateSessionAsync(row.Id, "New Session");
        switch (outcome)
        {
            case CreateSessionSucceeded succeeded:
                row.AddSession(
                    new SessionRow(succeeded.Session.Id, row.Id, succeeded.Session.Name)
                );
                _editingSessionId = succeeded.Session.Id;
                _addSessionError = null;
                _collapsedIds.Remove(row.Id);
                break;
            case CreateSessionFailed failed:
                _addSessionError = failed.Error;
                break;
        }
    }

    private async Task RenameSessionAsync(SessionRow session)
    {
        if (session.IsSaving)
        {
            return;
        }

        var trimmedLength = session.Name.Trim().Length;
        if (trimmedLength is < MinNameLength or > MaxNameLength)
        {
            session.Error =
                $"Name must be between {MinNameLength} and {MaxNameLength} characters.";
            return;
        }

        session.IsSaving = true;
        try
        {
            var outcome = await SessionsApi.RenameSessionAsync(
                session.ProgramId,
                session.Id,
                session.Name
            );
            switch (outcome)
            {
                case RenameSessionSucceeded succeeded:
                    session.Name = succeeded.Session.Name;
                    session.SavedName = succeeded.Session.Name;
                    session.Error = null;
                    break;
                case RenameSessionFailed failed:
                    session.Error = failed.Error;
                    break;
            }
        }
        finally
        {
            session.IsSaving = false;
        }
    }

    private static void RevertSession(SessionRow session)
    {
        session.Name = session.SavedName;
        session.Error = null;
    }

    private async Task DeleteSessionAsync(ProgramRow row, SessionRow session)
    {
        var outcome = await SessionsApi.DeleteSessionAsync(session.ProgramId, session.Id);
        switch (outcome)
        {
            case DeleteSessionSucceeded:
                row.RemoveSession(session);
                if (!HasToggleableContent(row))
                {
                    _collapsedIds.Remove(row.Id);
                }

                _deleteSessionError = null;
                break;
            case DeleteSessionFailed failed:
                _deleteSessionError = failed.Error;
                break;
        }
    }

}
