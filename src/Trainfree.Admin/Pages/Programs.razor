    private bool CanSubmitAddExercise =>
        !string.IsNullOrEmpty(_addExerciseExerciseId)
        && _addExerciseCount is > 0
        && _addExerciseSets is > 0
        && _addExerciseRestSeconds is > 0;

    private static int? ParseNullableInt(object? value) =>
        int.TryParse(value as string, out var parsed) ? parsed : null;

    private static int ParseInt(object? value) => int.TryParse(value as string, out var parsed) ? parsed : 0;

    private static string DashIfZero(decimal value) =>
        value == 0 ? "–" : value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private static void SetWeight(ProgramExerciseRow row, string? text)
    {
        row.WeightText = text ?? "";
        row.WeightIsValid = decimal.TryParse(
            row.WeightText,
            System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture,
            out var parsed
        );
        if (row.WeightIsValid)
        {
            row.Weight = parsed;
        }
    }

