@page "/exercises"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Logging
@using Trainfree.Admin.Admin
@using Trainfree.Domain.Ids
@inject IExercisesApiClient Api
@inject ILogger<Exercises> Logger
@inject HttpClient Http
@inject IImageResizer ImageResizer

<PageTitle>Exercises - Trainfree Admin</PageTitle>

<div class="page-header d-flex align-items-end justify-content-between flex-wrap gap-3">
    <div>
        <h1>Exercises</h1>
        <p class="page-sub mb-0">
            The canonical exercise library -- names like "Bodyweight Squat" or "Skater
            Jump" live here once, and program exercises pick from this list instead of
            typing free text.
        </p>
    </div>
    @if (_rows.Count > 0)
    {
        <AddButton TestId="add-exercise" Label="Add Exercise" OnClick="AddExerciseAsync" />
    }
</div>

<InlineError Message="@_addExerciseError" TestId="add-exercise-error" Class="mb-2" />
<InlineError Message="@_loadError" TestId="load-exercises-error" Class="mb-2" />

@if (_isLoading)
{
    <div class="sheet-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody class="placeholder-wave" aria-busy="true" aria-live="polite">
                @for (var i = 0; i < SkeletonDefaults.RowCount; i++)
                {
                    <tr>
                        <td><SkeletonBlock Width="44px" Height="44px" /></td>
                        <td><SkeletonBlock Width="60%" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_rows.Count == 0 && _loadError is null)
{
    <div class="text-center py-5" data-testid="exercises-empty">
        <div class="tile-icon mx-auto mb-3" aria-hidden="true">
            <i class="bi bi-lightning-fill"></i>
        </div>
        <h2 class="h5">No exercises yet</h2>
        <p class="page-sub mx-auto">
            Your exercise library holds the canonical name for every move --
            things like "Bodyweight Squat" or "Skater Jump". Add your first one, then
            pick it from any program instead of typing it out.
        </p>
        <AddButton TestId="add-exercise-empty" Label="Add Exercise" OnClick="AddExerciseAsync" />
    </div>
}
else
{
    <div class="sheet-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr class="row-depth-0">
                        <td class="image-col">
                            <ExerciseImageCell
                                RowId="@row.Id.ToString()"
                                ExerciseName="@row.SavedName"
                                Src="@ImageSrc(row)"
                                Error="@row.ImageError"
                                OnFilePicked="e => PickFileAsync(row, e)"
                                OnDelete="() => DeleteImageAsync(row)" />
                        </td>
                        <td>
                            <div class="name-cell">
                                <input
                                    class="cell-input"
                                    data-testid="name-input-@row.Id"
                                    value="@row.Name"
                                    autofocus="@(row.Id == _editingId)"
                                    disabled="@row.IsSaving"
                                    @oninput="e => row.Name = (string)e.Value!"
                                    @onkeydown="e => OnNameKeyDownAsync(e, row)" />
                                <div class="name-actions">
                                    <SaveRevertButtons
                                        SaveTestId="@($"save-{row.Id}")"
                                        RevertTestId="@($"revert-{row.Id}")"
                                        IsDirty="@row.IsDirty"
                                        IsSaving="@row.IsSaving"
                                        OnSave="() => RenameAsync(row)"
                                        OnRevert="() => Revert(row)"
                                    />
                                    <DeleteButton TestId="@($"delete-{row.Id}")" OnClick="() => DeleteAsync(row)" />
                                </div>
                            </div>
                            <InlineError Message="@row.Error" TestId="@($"name-error-{row.Id}")" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_staging is { } staging)
{
    <ImageStagingModal
        ExerciseName="@staging.Row.SavedName"
        PreviewSrc="@staging.PreviewSrc"
        CurrentSrc="@ImageSrc(staging.Row)"
        IsUploading="@staging.IsUploading"
        Error="@staging.Error"
        OnUpload="UploadStagedImageAsync"
        OnCancel="CancelStaging"
        OnFilePicked="e => PickFileAsync(staging.Row, e)" />
}

@code {
    private StagingSession? _staging;
    private readonly List<ExerciseRow> _rows = [];
    private ExerciseId? _editingId;
    private string? _addExerciseError;
    private string? _loadError;
    private bool _isLoading = true;

    private const int MinNameLength = 4;
    private const int MaxNameLength = 100;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var exercises = await Api.GetExercisesAsync();
            _rows.AddRange(exercises.Select(e => new ExerciseRow(e.Id, e.Name, e.ImageUrl)));
        }
        // HttpRequestException alone was not enough: Cloudflare Access answers a request made
        // before the session is established with its own HTML login page, which arrives as a
        // JsonException and escaped, blanking the page instead of showing the load error.
        // The charset and content-type cases come with it; a timeout arrives as a cancellation.
        // FormatException covers a successful response whose exercise id doesn't match the
        // generator's shape (a hand-edited row, a future migration bug).
        catch (Exception ex)
            when (ex
                    is HttpRequestException
                        or JsonException
                        or InvalidOperationException
                        or NotSupportedException
                        or OperationCanceledException
                        or FormatException
            )
        {
            _loadError = "Could not load exercises. Try refreshing the page.";
            LogLoadExercisesFailed(Logger, ex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AddExerciseAsync()
    {
        var outcome = await Api.CreateExerciseAsync("New Exercise");
        switch (outcome)
        {
            case CreateExerciseSucceeded succeeded:
                _rows.Add(
                    new ExerciseRow(
                        succeeded.Exercise.Id,
                        succeeded.Exercise.Name,
                        succeeded.Exercise.ImageUrl
                    )
                );
                _editingId = succeeded.Exercise.Id;
                _addExerciseError = null;
                break;
            case CreateExerciseFailed failed:
                _addExerciseError = failed.Error;
                break;
        }
    }

    private async Task RenameAsync(ExerciseRow row)
    {
        if (row.IsSaving)
        {
            return;
        }

        var trimmedLength = row.Name.Trim().Length;
        if (trimmedLength is < MinNameLength or > MaxNameLength)
        {
            row.Error = $"Name must be between {MinNameLength} and {MaxNameLength} characters.";
            return;
        }

        row.IsSaving = true;
        try
        {
            var outcome = await Api.RenameExerciseAsync(row.Id, row.Name);
            switch (outcome)
            {
                case RenameExerciseSucceeded succeeded:
                    row.Name = succeeded.Exercise.Name;
                    row.SavedName = succeeded.Exercise.Name;
                    row.Error = null;
                    break;
                case RenameExerciseFailed failed:
                    row.Error = failed.Error;
                    break;
            }
        }
        finally
        {
            row.IsSaving = false;
        }
    }

    // The API returns a path rooted at the origin ("/api/..."); resolving it against the
    // API base address keeps it pointing at the Worker when the app runs on another origin
    // (local dev), and is a no-op same-origin in production.
    private string? ImageSrc(ExerciseRow row) =>
        row.Image is HasImage hasImage && Http.BaseAddress is { } baseAddress
            ? new Uri(baseAddress, hasImage.Url).ToString()
            : (row.Image as HasImage)?.Url;

    private async Task PickFileAsync(ExerciseRow row, InputFileChangeEventArgs e)
    {
        var file = e.File;
        var validation = ImageFileValidator.Validate(file.ContentType, file.Size);
        switch (validation)
        {
            case ImageFileRejected rejected:
                ReportPickError(row, rejected.Error);
                break;
            case ImageFileAccepted accepted:
                await StageAsync(row, file, accepted.ContentType);
                break;
        }
    }

    private async Task StageAsync(ExerciseRow row, IBrowserFile file, string contentType)
    {
        try
        {
            using var buffer = new MemoryStream();
            await using (var source = file.OpenReadStream(ImageFileValidator.MaxBytes))
            {
                await source.CopyToAsync(buffer);
            }

            var staged = await ImageResizer.ResizeAsync(buffer.ToArray(), contentType);
            // Re-encoding can enlarge an image, so the output must pass the same limit.
            if (
                ImageFileValidator.Validate(staged.ContentType, staged.Content.Length)
                is ImageFileRejected rejected
            )
            {
                ReportPickError(row, rejected.Error);
                return;
            }

            if (_staging is null)
            {
                _staging = new StagingSession(row, staged);
            }
            else
            {
                _staging.Restage(staged);
            }

            row.ImageError = null;
        }
        catch (Exception ex)
            when (ex is IOException or JSException or ArgumentException or InvalidOperationException)
        {
            LogImageProcessingFailed(Logger, ex);
            ReportPickError(row, "Could not process that image. Try a different file.");
        }
    }

    // While the modal is open, a bad replacement file is reported in the modal and the
    // previous preview stays; otherwise the error belongs to the row that started the pick.
    private void ReportPickError(ExerciseRow row, string error)
    {
        if (_staging is null)
        {
            row.ImageError = error;
        }
        else
        {
            _staging.Error = error;
        }
    }

    private void CancelStaging() => _staging = null;

    private async Task UploadStagedImageAsync()
    {
        if (_staging is not { IsUploading: false } staging)
        {
            return;
        }

        staging.IsUploading = true;
        staging.Error = null;
        try
        {
            var outcome = await Api.UploadExerciseImageAsync(staging.Row.Id, staging.Staged);
            switch (outcome)
            {
                case UploadExerciseImageSucceeded succeeded:
                    staging.Row.Image = succeeded.Exercise.ImageUrl is { } url
                        ? new HasImage(url)
                        : new NoImage();
                    staging.Row.ImageError = null;
                    _staging = null;
                    break;
                case UploadExerciseImageFailed failed:
                    staging.Error = failed.Error;
                    break;
            }
        }
        finally
        {
            staging.IsUploading = false;
        }
    }

    private async Task DeleteImageAsync(ExerciseRow row)
    {
        var outcome = await Api.DeleteExerciseImageAsync(row.Id);
        switch (outcome)
        {
            case DeleteExerciseImageSucceeded:
                row.Image = new NoImage();
                row.ImageError = null;
                break;
            case DeleteExerciseImageFailed failed:
                row.ImageError = failed.Error;
                break;
        }
    }

    private async Task OnNameKeyDownAsync(KeyboardEventArgs e, ExerciseRow row)
    {
        if (e.Key == "Enter" && row.IsDirty)
        {
            await RenameAsync(row);
        }
    }

    private static void Revert(ExerciseRow row)
    {
        row.Name = row.SavedName;
        row.Error = null;
    }

    private async Task DeleteAsync(ExerciseRow row)
    {
        var outcome = await Api.DeleteExerciseAsync(row.Id);
        switch (outcome)
        {
            case DeleteExerciseSucceeded:
                _rows.Remove(row);
                break;
            case DeleteExerciseFailed failed:
                row.Error = failed.Error;
                break;
        }
    }

    private sealed class ExerciseRow
    {
        public ExerciseRow(ExerciseId id, string name, string? imageUrl)
        {
            Id = id;
            Name = name;
            SavedName = name;
            Image = imageUrl is null ? new NoImage() : new HasImage(imageUrl);
        }

        public ExerciseImage Image { get; set; }
        public string? ImageError { get; set; }

        public ExerciseId Id { get; }
        public string Name { get; set; }
        public string SavedName { get; set; }
        public bool IsDirty => !string.Equals(Name, SavedName, StringComparison.Ordinal);
        public bool IsSaving { get; set; }
        public string? Error { get; set; }
    }

    private sealed class StagingSession
    {
        public StagingSession(ExerciseRow row, StagedImage staged)
        {
            Row = row;
            Staged = staged;
            PreviewSrc = ToDataUrl(staged);
        }

        public ExerciseRow Row { get; }
        public StagedImage Staged { get; private set; }
        public string PreviewSrc { get; private set; }
        public bool IsUploading { get; set; }
        public string? Error { get; set; }

        public void Restage(StagedImage staged)
        {
            Staged = staged;
            PreviewSrc = ToDataUrl(staged);
            Error = null;
        }

        private static string ToDataUrl(StagedImage staged) =>
            $"data:{staged.ContentType};base64,{Convert.ToBase64String(staged.Content.Span)}";
    }
}
