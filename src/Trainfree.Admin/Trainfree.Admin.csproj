<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The SDK otherwise appends ".<full-sha>" to whatever InformationalVersion deploy.yaml
         passes, so the stamp compiled in here would never equal the shorter one the Worker
         reports and the update banner would fire on every load. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trainfree.Admin.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trainfree.ApiClients\Trainfree.ApiClients.csproj" />
    <ProjectReference Include="..\Trainfree.Domain\Trainfree.Domain.csproj" />
    <ProjectReference Include="..\Trainfree.Versioning\Trainfree.Versioning.csproj" />
  </ItemGroup>
</Project>
