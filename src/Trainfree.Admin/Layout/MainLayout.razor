@inherits LayoutComponentBase
<header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-0 shadow">
    <button
        title="Navigation menu"
        aria-label="Navigation menu"
        aria-expanded="@(_navCollapsed ? "false" : "true")"
        class="navbar-toggler d-md-none ms-3"
        type="button"
        @onclick="ToggleNavMenu"
    >
        <span class="navbar-toggler-icon"></span>
    </button>
    <NavLink
        class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-5 fw-semibold d-flex align-items-center gap-2"
        href=""
        Match="NavLinkMatch.All"
    >
        <span class="d-inline-flex" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1.25" y="8.5" width="2.75" height="7" rx="1" />
                <rect x="20" y="8.5" width="2.75" height="7" rx="1" />
                <line x1="4" y1="12" x2="20" y2="12" />
                <rect x="6.5" y="6.25" width="2.75" height="11.5" rx="1" />
                <rect x="14.75" y="6.25" width="2.75" height="11.5" rx="1" />
            </svg>
        </span>
        Trainfree Admin
    </NavLink>
    <div class="navbar-nav flex-row ms-md-auto">
        <div class="nav-item text-nowrap px-3 d-flex align-items-center gap-3">
            @* The version banner is advisory, so its blast radius is bounded structurally
               rather than by enumerating what the check can throw. A trip costs the whole
               indicator -- stamp included, unlike VersionUnknown, which suppresses only the
               banner -- but never the app. No error UI: a broken advisory is not worth a
               message to the user. The empty ErrorContent is required; omitting it falls
               back to Blazor's own visible error UI. *@
            <ErrorBoundary @ref="_versionBoundary">
                <ChildContent>
                    <VersionIndicator />
                </ChildContent>
                <ErrorContent></ErrorContent>
            </ErrorBoundary>
        </div>
    </div>
</header>

<div class="container-fluid">
    <div class="row">
        <NavMenu Collapsed="_navCollapsed" />

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-3">
            <ErrorBoundary @ref="_pageBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger" role="alert" data-testid="page-error">
                        Something went wrong on this page. Try again, or reload the app.
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

@code {
    private ErrorBoundary? _pageBoundary;
    private ErrorBoundary? _versionBoundary;
    private bool _navCollapsed = true;

    // A boundary latches its error until told otherwise, and this layout is the router's
    // DefaultLayout -- one instance for the life of the tab. Without this, one transient
    // failure would hide the page (or the build stamp, which exists precisely so a stale
    // bundle cannot serve silently) until a full reload. Navigating hands the layout a new
    // Body, which is the point at which the previous failure stops being relevant.
    protected override void OnParametersSet()
    {
        _pageBoundary?.Recover();
        _versionBoundary?.Recover();
    }

    private void ToggleNavMenu() => _navCollapsed = !_navCollapsed;
}
