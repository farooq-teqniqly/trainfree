{
    "name": "trainfree-admin",
    "main": "src/index.js",
    // Pinned to the newest date the installed @cloudflare/vitest-pool-workers runtime
    // understands (workerd 1.20250906.0) -- a later date silently falls back to this one
    // anyway, with a warning on every test file. Bump alongside vitest-pool-workers/wrangler
    // once a newer installed runtime supports a later date. Keep in sync with
    // wrangler.deploy.jsonc.
    "compatibility_date": "2025-09-06",
    // 9999, not wrangler's stock 8787: 8787 was observed to leak orphaned listener
    // processes on Windows across restarts, silently hanging every future connection
    // until the OS was rebooted. 9999 has shown no such issue.
    "dev": {
        "port": 9999
    },
    // Local-only: no Cloudflare Access edge runs in front of `wrangler dev`, so
    // identity.js substitutes a synthetic Administrator identity instead of calling
    // IDENTITY -- see identity.js and CLAUDE-domain-driven-design-adjacent spec
    // "Local dev bypasses the service-binding call, not the role check". Never set in
    // wrangler.deploy.jsonc: a deployed Worker missing this must fail closed, not
    // silently behave like local dev.
    "vars": {
        "LOCAL_DEV_BYPASS": "true"
    },
    // Routes GET /internal/identity calls to a locally running `wrangler dev` for
    // Trainfree.IdentityApi (multi-worker local dev auto-discovers it by `service`
    // name -- no "remote": true needed, unlike smoke-harness/wrangler.jsonc's binding
    // of the same name, which deliberately reaches the deployed Worker instead). Only
    // exercised when LOCAL_DEV_BYPASS is unset.
    "services": [
        {
            "binding": "IDENTITY",
            "service": "trainfree-identity-api"
        }
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "trainfree_db",
            // Created once with `wrangler d1 create trainfree_db` (see CLAUDE.md: resource
            // creation is a separate, non-idempotent setup script, never part of the deploy
            // pipeline). Not a secret. Not required for `--local` migrations/dev, which use a
            // local sqlite file regardless of this value.
            "database_id": "f99013f2-e1c9-48d7-9f63-cfb3c853f421"
        }
    ],
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
        }
    }
    // No `assets` block here: this config is used for local `wrangler dev` and for
    // `vitest`/Miniflare, neither of which has (or needs) a Blazor publish output on
    // disk. The production deploy uses wrangler.deploy.jsonc instead, which adds
    // `assets` pointing at the published Trainfree.Admin wwwroot -- see that file and
    // CLAUDE.md's Project-specific rules for the per-app Worker architecture.
}
