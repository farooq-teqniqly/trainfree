#!/bin/sh
#
# Pre-commit hook:
#   1. format staged C# files with CSharpier (from dotnet-tools.json). Formatted files
#      are re-staged so the commit contains the formatted result.
#   2. lint staged workflow and shell files with actionlint and ShellCheck. Both are
#      required tooling: staging a file they cover without them installed fails the commit.
#
set -e

# Both linters are required tooling (see README, "Required tooling"), so a missing binary
# fails the commit rather than silently skipping the check -- a skipped lint locally just
# moves the failure to CI, after the push. They are checked only when a file they cover is
# staged, so a contributor touching neither never needs them.
#
# Note on the list below: a comment whose first word is "shellcheck" parses as a lint
# directive and errors, hence the leading dashes.
#   - actionlint: https://github.com/rhysd/actionlint/releases
#   - shellcheck: https://github.com/koalaman/shellcheck/releases
require_tool() {
	command -v "$1" >/dev/null 2>&1 && return 0
	printf '%s is required to commit changes to %s but was not found on PATH.\n' "$1" "$2" >&2
	# The URL, not just a pointer to a doc section: this message is what a contributor
	# sees at the moment they are blocked, and a repo bootstrapped from the template may
	# not carry that section yet.
	case "$1" in
	actionlint) printf 'Download: https://github.com/rhysd/actionlint/releases\n' >&2 ;;
	*) printf 'Download: https://github.com/koalaman/shellcheck/releases\n' >&2 ;;
	esac
	printf 'See "Required tooling" in README.md, if present.\n' >&2
	return 1
}

lint_staged() {
	staged_yaml=$(git diff --cached --name-only --diff-filter=ACMR -- '.github/workflows/*.yaml' '.github/workflows/*.yml')
	staged_sh=$(git diff --cached --name-only --diff-filter=ACMR -- '.github/scripts/*.sh' '.githooks/*')

	if [ -n "$staged_yaml" ]; then
		require_tool actionlint "GitHub Actions workflows" || return 1
		# actionlint lints `run:` blocks only when shellcheck is present, and says nothing
		# when it is not -- so demand it here too rather than accept a half-check.
		require_tool shellcheck "GitHub Actions workflows" || return 1
		# Only the staged files. Linting the whole directory meant an unrelated,
		# half-finished workflow in the working tree could block a commit that does not
		# touch it. actionlint checks each workflow independently, so nothing is lost.
		printf '%s\n' "$staged_yaml" | while IFS= read -r file; do
			[ -f "$file" ] || continue
			actionlint "$file" || exit 1
		done || return 1
	fi

	if [ -n "$staged_sh" ]; then
		require_tool shellcheck "shell scripts" || return 1
		# printf, not echo, for the same reason as the CSharpier loop below.
		printf '%s\n' "$staged_sh" | while IFS= read -r file; do
			[ -f "$file" ] || continue
			shellcheck "$file" || exit 1
		done || return 1
	fi

	return 0
}

lint_staged

# CSharpier 1.x formats C# and XML project/config files; match the same set here
# so the hook can't miss drift that `dotnet csharpier check .` would later flag in CI.
# ACMR: include Renamed files so a rename (with or without edits) still gets formatted.
staged=$(git diff --cached --name-only --diff-filter=ACMR \
	-- '*.cs' '*.csproj' '*.props' '*.targets' '*.config' '*.slnx')
[ -z "$staged" ] && exit 0

# Ensure the local tool is available.
dotnet tool restore >/dev/null

# printf, not echo: echo may mangle backslash escapes or treat a leading '-' as an option.
printf '%s\n' "$staged" | while IFS= read -r file; do
	[ -f "$file" ] || continue
	dotnet csharpier format "$file"
	git add -- "$file"
done
